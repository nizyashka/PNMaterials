<Page x:Class="PNMaterialsClient.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:PNMaterialsClient.Services"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:controls="using:PNMaterialsClient.Views.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:tv="using:WinUI.TableView">

    <tv:TableView Style="{StaticResource EntityTableStyle}"
                  ItemsSource="{x:Bind ViewModel.Users}">
        <tv:TableView.Columns>
            <tv:TableViewTextColumn Header="Логин" Binding="{Binding Username}" Width="*" />
            <tv:TableViewTextColumn Header="Полное имя" Binding="{Binding FullName}" Width="*" />
            <tv:TableViewTextColumn Header="Роли" Binding="{Binding RolesString}" Width="*" />
        </tv:TableView.Columns>
    </tv:TableView>
</Page>
