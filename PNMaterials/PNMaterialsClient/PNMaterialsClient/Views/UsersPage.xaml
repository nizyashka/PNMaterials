<Page x:Class="PNMaterialsClient.Views.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:PNMaterialsClient.Services"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:controls="using:PNMaterialsClient.Views.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:tv="using:WinUI.TableView">

    <tv:TableView Style="{StaticResource EntityTableStyle}"
                  ItemsSource="{x:Bind ViewModel.Users}">
        <tv:TableView.Columns>
            <tv:TableViewTextColumn Header="Логин" Binding="{Binding Username}" Width="*" />
            <tv:TableViewTextColumn Header="Полное имя" Binding="{Binding FullName}" Width="*" />
            <tv:TableViewTextColumn Header="Роли" Binding="{Binding RolesString}" Width="*" />
            <tv:TableViewTemplateColumn Header="Действия" Width="Auto">
                <tv:TableViewTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Padding="8"
                                    HorizontalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="Редактировать пользователя">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Редактировать профиль" Click="OnEditUserProfileClick" />
                                        <MenuFlyoutItem Text="Изменить роли" Click="OnEditUserRolesClick" />
                                        <MenuFlyoutItem Text="Изменить пароль" Click="OnEditUserPasswordClick" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE70F;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14" />
                            </Button>

                            <Button Style="{StaticResource IconButtonStyle}">
                                <FontIcon Glyph="&#xE74D;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontSize="14" />
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </tv:TableViewTemplateColumn.CellTemplate>
            </tv:TableViewTemplateColumn>
        </tv:TableView.Columns>
    </tv:TableView>
</Page>
