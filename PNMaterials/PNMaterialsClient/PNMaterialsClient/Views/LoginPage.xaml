<Page x:Class="PNMaterialsClient.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:PNMaterialsClient.ViewModels"
      Background="{StaticResource AppBackgroundBrush}">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="200"
                Spacing="16">
        <TextBox x:Name="LoginTextBox"
                 PlaceholderText="Логин"
                 Text="{x:Bind LoginViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnLoginTextBoxKeyDown"/>

        <PasswordBox x:Name="PasswordTextBox"
                     PlaceholderText="Пароль"
                     PasswordRevealMode="Hidden"
                     Text="{x:Bind LoginViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OnPasswordTextBoxKeyDown"/>

        <Button x:Name="LogInButton"
                Style="{StaticResource IconButtonStyle}"
                Command="{x:Bind LoginViewModel.LogInCommand}"
                Content="Войти"
                Width="Auto"
                HorizontalAlignment="Stretch" />
    </StackPanel>
</Page>
