<Page x:Class="PNMaterialsClient.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:PNMaterialsClient.ViewModels"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="200"
                Spacing="16">
        <TextBox PlaceholderText="Логин"
                 Text="{x:Bind LoginViewModel.Login, Mode=TwoWay}" />

        <TextBox PlaceholderText="Пароль"
                 Text="{x:Bind LoginViewModel.Password, Mode=TwoWay}" />

        <Button Style="{StaticResource IconButtonStyle}"
                Command="{x:Bind LoginViewModel.LogInCommand}"
                Content="Войти"
                Width="Auto"
                HorizontalAlignment="Stretch" />

        <TextBlock x:Name="FailedLoginTextBlock"
                   Text="Неудачная попытка входа"
                   Foreground="Red" />
    </StackPanel>
</Page>
