<Page x:Class="PNMaterialsClient.Views.MaterialsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:tv="using:WinUI.TableView">

    <controls:EntityListView Title="Материалы"
                             Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                             CreateClicked="OnCreateClick">

        <controls:EntityListView.Table>
            <tv:TableView Style="{StaticResource EntityTableStyle}"
                          ItemsSource="{x:Bind ViewModel.Materials}"
                          ItemClick="OnMaterialClick">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Наименование" Binding="{Binding Name}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Группа" Binding="{Binding GroupName}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                </tv:TableView.Columns>
            </tv:TableView>
        </controls:EntityListView.Table>
    </controls:EntityListView>
</Page>
