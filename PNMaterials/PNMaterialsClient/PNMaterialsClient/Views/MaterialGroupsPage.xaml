<Page x:Class="PNMaterialsClient.Views.MaterialGroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:contracts="using:PNMaterialsContracts">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Группы материалов" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Создать" Click="OnCreateClick" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" />

        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Groups}"
                  IsItemClickEnabled="True" ItemClick="OnGroupClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="contracts:MaterialGroupDto">
                    <StackPanel Padding="0,8">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Description}" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
