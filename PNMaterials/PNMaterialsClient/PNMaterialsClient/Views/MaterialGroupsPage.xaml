<Page x:Class="PNMaterialsClient.Views.MaterialGroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:tv="using:WinUI.TableView">

    <controls:EntityListView Title="Группы материалов"
                             Status="{x:Bind ViewModel.Status, Mode=OneWay}"
                             CreateClicked="OnCreateClick">

        <controls:EntityListView.Table>
            <tv:TableView Style="{StaticResource EntityTableStyle}"
                          ItemsSource="{x:Bind ViewModel.Groups}"
                          ItemClick="OnGroupClick">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Header="Наименование" Binding="{Binding Name}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                </tv:TableView.Columns>
            </tv:TableView>
        </controls:EntityListView.Table>
    </controls:EntityListView>
</Page>
