<Page x:Class="PNMaterialsClient.Views.PurchaseRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:converters="using:PNMaterialsClient.Converters"
      xmlns:tv="using:WinUI.TableView">

    <Page.Resources>
        <converters:DateFormatConverter x:Key="DateFormat" />
    </Page.Resources>

    <controls:EntityListView Title="Заявки на закупку"
                             Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                             CreateClicked="OnCreateClick">

        <controls:EntityListView.Table>
            <tv:TableView Style="{StaticResource EntityTableStyle}"
                          ItemsSource="{x:Bind ViewModel.Requests}"
                          ItemClick="OnRequestClick">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Header="Номер" Binding="{Binding Number}" Width="*" />
                    <tv:TableViewTextColumn Header="Дата создания" Binding="{Binding CreatedAt, Converter={StaticResource DateFormat}}" Width="*" />
                    <tv:TableViewTextColumn Header="Дата поставки" Binding="{Binding DeliveryDate, Converter={StaticResource DateFormat}}" Width="*" />
                    <tv:TableViewTextColumn Header="Статус" Binding="{Binding Status.Title}" Width="*" />
                    <tv:TableViewNumberColumn Header="Позиций" Binding="{Binding Items.Count}" Width="Auto" />
                </tv:TableView.Columns>
            </tv:TableView>
        </controls:EntityListView.Table>
    </controls:EntityListView>
</Page>
