<Page x:Class="PNMaterialsClient.Views.RootPage"
      NavigationCacheMode="Enabled"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:PNMaterialsClient.Services"
      xmlns:controls="using:PNMaterialsClient.Views.Controls">

    <Grid>
        <Frame x:Name="RootPageFrame"></Frame>

        <Popup x:Name="InfoPopup">
            <Grid x:Name="PopupGrid">
                <ItemsControl x:Name="PopupItemsControl"
                      ItemsSource="{x:Bind MessagesService.Messages, Mode=OneWay}"
                      Width="300"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Padding="16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:UiMessage">
                            <controls:MessageBar Message="{x:Bind}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Popup>
    </Grid>
</Page>
