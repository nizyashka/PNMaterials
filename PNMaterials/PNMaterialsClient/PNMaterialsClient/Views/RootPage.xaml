<Page x:Class="PNMaterialsClient.Views.RootPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:PNMaterialsClient.Services"
      xmlns:controls="using:PNMaterialsClient.Views.Controls">

    <Grid>
        <Frame x:Name="RootPageFrame"></Frame>
        
        <Popup x:Name="InfoPopup">
            <Grid x:Name="PopupGrid">
                <ItemsControl x:Name="PopupItemsControl"
                              ItemsSource="{x:Bind MessagesService.Messages, Mode=OneWay}"
                              Width="300"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Padding="16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:UiMessage">
                            <controls:MessageBar Message="{x:Bind}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Popup>

        <Popup x:Name="ProgressPopup" IsOpen="{x:Bind LoadingService.IsBusy, Mode=OneWay}">
            <Grid x:Name="ProgressGrid">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <ProgressRing Width="32"
                                  Height="32"
                                  IsActive="True" />
                </Border>
            </Grid>
        </Popup>
    </Grid>
</Page>
