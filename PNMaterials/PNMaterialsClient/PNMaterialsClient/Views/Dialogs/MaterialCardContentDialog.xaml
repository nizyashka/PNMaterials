<ContentDialog x:Class="PNMaterialsClient.Views.Dialogs.MaterialCardContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:PNMaterialsClient.Controls">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">500</x:Double>
    </ContentDialog.Resources>

    <controls:EntityCard Header="{x:Bind ViewModel.Header, Mode=OneWay}"
                         IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                         SaveCommand="{x:Bind ViewModel.SaveCommand}"
                         DeleteCommand="{x:Bind DeleteCommand}"
                         RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
                         ExitCommand="{x:Bind ExitCommand}"
                         Message="{x:Bind ViewModel.Message, Mode=OneWay}">

        <controls:EntityCard.ExtraButtons>
            <Button Content="Создать заявку"
                    Click="OnCreateRequestClick"
                    IsEnabled="{x:Bind ViewModel.CanCreateRequest, Mode=OneWay}" />
        </controls:EntityCard.ExtraButtons>

        <StackPanel Spacing="16">
            <TextBox Header="Код материала"
                     Text="{x:Bind ViewModel.Code, Mode=OneWay}"
                     IsEnabled="False" />

            <TextBox Header="Наименование материала *"
                     Text="{x:Bind ViewModel.Name, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="40" />

            <TextBox Header="Описание материала"
                     Text="{x:Bind ViewModel.Description, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="200"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="120" />

            <ComboBox Header="Единица измерения *"
                      ItemsSource="{x:Bind ViewModel.Units}"
                      SelectedItem="{x:Bind ViewModel.SelectedUnit, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                      HorizontalAlignment="Stretch" />

            <ComboBox Header="Группа материалов *"
                      ItemsSource="{x:Bind ViewModel.Groups}"
                      SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
                      DisplayMemberPath="Name"
                      IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                      HorizontalAlignment="Stretch" />
        </StackPanel>
    </controls:EntityCard>
</ContentDialog>
