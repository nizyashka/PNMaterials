<ContentDialog x:Class="PNMaterialsClient.Views.Dialogs.PurchaseRequestCardContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:PNMaterialsClient.Controls"
               xmlns:vm="using:PNMaterialsClient.ViewModels">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">700</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1100</x:Double>
    </ContentDialog.Resources>

    <controls:EntityCard Header="{x:Bind ViewModel.Header, Mode=OneWay}"
                         IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                         SaveCommand="{x:Bind ViewModel.SaveCommand}"
                         RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
                         ExitCommand="{x:Bind ExitCommand}">

        <controls:EntityCard.ExtraButtons>
            <ItemsControl ItemsSource="{x:Bind ViewModel.StatusActions, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusActionViewModel">
                        <Button Content="{x:Bind Text}" Command="{x:Bind Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:EntityCard.ExtraButtons>

        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="16">
                <TextBox Header="Номер заявки"
                         Text="{x:Bind ViewModel.Number, Mode=OneWay}"
                         IsEnabled="False" />

                <TextBox Header="Дата-время создания"
                         Text="{x:Bind ViewModel.CreatedAt, Mode=OneWay}"
                         IsEnabled="False" />

                <TextBox Header="Статус заявки"
                         Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                         IsEnabled="False" />

                <DatePicker Header="Дата поставки"
                            Date="{x:Bind ViewModel.DeliveryDate, Mode=TwoWay}"
                            IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                            HorizontalAlignment="Left" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Позиции заявки"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.AddItemCommand}"
                        IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                        ToolTipService.ToolTip="Добавить">
                    <FontIcon Glyph="&#xE710;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="8" Padding="0,0,0,4" Opacity="0.6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="НН материала" />
                <TextBlock Grid.Column="1" Text="Наименование" />
                <TextBlock Grid.Column="2" Text="Ед. изм." />
                <TextBlock Grid.Column="3" Text="Количество" />
                <TextBlock Grid.Column="4" Text="Текст к позиции" />
            </Grid>

            <ScrollViewer Grid.Row="3">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RequestItemViewModel">
                            <Grid ColumnSpacing="8" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="300" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          ItemsSource="{x:Bind Materials}"
                                          SelectedItem="{x:Bind Material, Mode=TwoWay}"
                                          DisplayMemberPath="Code"
                                          IsEnabled="{x:Bind IsEditMode, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind MaterialName, Mode=OneWay}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind UnitName, Mode=OneWay}"
                                           VerticalAlignment="Center" />

                                <NumberBox Grid.Column="3"
                                           Value="{x:Bind Quantity, Mode=TwoWay}"
                                           Minimum="0.01" Maximum="999999.99"
                                           SpinButtonPlacementMode="Compact"
                                           IsEnabled="{x:Bind IsEditMode, Mode=OneWay}" />

                                <TextBox Grid.Column="4"
                                         Text="{x:Bind PositionText, Mode=TwoWay}"
                                         MaxLength="200"
                                         IsEnabled="{x:Bind IsEditMode, Mode=OneWay}" />

                                <Button Grid.Column="5"
                                        Style="{StaticResource IconButtonStyle}"
                                        Command="{x:Bind RemoveCommand}"
                                        IsEnabled="{x:Bind IsEditMode, Mode=OneWay}"
                                        ToolTipService.ToolTip="Убрать">
                                    <FontIcon Glyph="&#xE711;"
                                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                              FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="4"
                       Margin="0,12,0,0"
                       Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                       Opacity="0.7" TextWrapping="Wrap" />
        </Grid>
    </controls:EntityCard>
</ContentDialog>
