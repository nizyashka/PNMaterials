<ContentDialog x:Class="PNMaterialsClient.Views.Dialogs.UserPasswordContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:controls="using:PNMaterialsClient.Views.Controls">

    <controls:EntityCard Header="Пароль"
                         IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                         SaveCommand="{x:Bind ViewModel.SaveCommand}"
                         ExitCommand="{x:Bind ExitCommand}">

        <TextBox Text="{x:Bind ViewModel.NewPassword, Mode=TwoWay}"
                 PlaceholderText="Новый пароль"
                 IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}" />
    </controls:EntityCard>
</ContentDialog>
