<ContentDialog x:Class="PNMaterialsClient.Views.Dialogs.UserCardContentDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
               xmlns:controls="using:PNMaterialsClient.Views.Controls"
               xmlns:vm="using:PNMaterialsClient.ViewModels">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">500</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">500</x:Double>
    </ContentDialog.Resources>

    <controls:EntityCard Header="{x:Bind ViewModel.Header, Mode=OneWay}"
                         IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                         SaveCommand="{x:Bind ViewModel.SaveCommand}"
                         RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
                         ExitCommand="{x:Bind ExitCommand}">

        <StackPanel Spacing="16">
            <TextBox Header="Логин *"
                     Text="{x:Bind ViewModel.Username, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="50"
                     controls:TextBoxCounter.CharCounter="True" />

            <TextBox Header="Имя *"
                     Text="{x:Bind ViewModel.FirstName, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="50"
                     controls:TextBoxCounter.CharCounter="True" />

            <TextBox Header="Фамилия *"
                     Text="{x:Bind ViewModel.LastName, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="50"
                     controls:TextBoxCounter.CharCounter="True" />

            <TextBox Header="Отчество"
                     Text="{x:Bind ViewModel.MiddleName, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                     MaxLength="50"
                     controls:TextBoxCounter.CharCounter="True" />

            <TextBox x:Name="PasswordTextBox"
                     Header="Пароль *"
                     Text="{x:Bind ViewModel.Password, Mode=TwoWay}"
                     IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Roles, Mode=OneWay}"
                          IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <toolkit:WrapPanel Orientation="Horizontal"
                                           HorizontalSpacing="8"
                                           VerticalSpacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleSelectionViewModel">
                        <Border Background="{StaticResource PanelBrush}"
                                CornerRadius="8"
                                Padding="6, 0">
                            <CheckBox Content="{x:Bind Name}"
                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      MinWidth="0" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </controls:EntityCard>
</ContentDialog>
