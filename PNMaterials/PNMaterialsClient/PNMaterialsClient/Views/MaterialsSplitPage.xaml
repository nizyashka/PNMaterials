<Page x:Class="PNMaterialsClient.Views.MaterialsSplitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:views="using:PNMaterialsClient.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:MessageBar Grid.Row="0" Message="{x:Bind MaterialGroupsViewModel.Message, Mode=OneWay}" />

            <ListView Grid.Row="1"
                      ItemsSource="{x:Bind MaterialGroupsViewModel.Groups}"
                      ItemContainerStyle="{StaticResource RoundedListViewItemStyle}"
                      IsItemClickEnabled="True"
                      ItemClick="OnGroupClick"
                      Background="{StaticResource PanelBrush}"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{StaticResource PanelBorderBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:MaterialGroupDto">
                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <toolkit:GridSplitter Grid.Column="1"
                              Width="16"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" />

        <views:MaterialsPage x:Name="MaterialsList" Grid.Column="2" />
    </Grid>
</Page>
