<Page x:Class="PNMaterialsClient.Views.MaterialsSplitPage"
      NavigationCacheMode="Enabled"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:tv="using:WinUI.TableView"
      xmlns:converters="using:PNMaterialsClient.Converters">

    <Page.Resources>
        <converters:BoolToBrushConverter x:Key="ArchivedForeground"
                                 TrueBrush="{StaticResource TextSecondaryBrush}"
                                 FalseBrush="{StaticResource TextPrimaryBrush}" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:MessageBar Grid.Row="0" Message="{x:Bind MaterialGroupsViewModel.Message, Mode=OneWay}" />

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ToggleButton  Grid.Column="0"
                        Height="32" Padding="0"
                        Click="OnIncludeArchivedClick"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Показывать архивированные группы">
                    <FontIcon x:Name="ArchiveToggleIcon"
          Glyph="&#xE890;"
          FontFamily="{ThemeResource SymbolThemeFontFamily}"
          FontSize="14" />
                </ToggleButton>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Click="OnCreateGroupClick"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Создать группу">
                    <FontIcon Glyph="&#xE710;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" />
                </Button>
            </Grid>

            <ListView Grid.Row="2"
                      x:Name="GroupsList"
                      ItemsSource="{x:Bind MaterialGroupsViewModel.Groups}"
                      ItemContainerStyle="{StaticResource RoundedListViewItemStyle}"
                      IsItemClickEnabled="True"
                      ItemClick="OnGroupClick"
                      DoubleTapped="OnEditGroupClick"
                      Background="{StaticResource PanelBrush}"
                      CornerRadius="8"
                      BorderThickness="1"
                      BorderBrush="{StaticResource PanelBorderBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:MaterialGroupDto">
                        <TextBlock Text="{x:Bind Name}"
                                   Foreground="{x:Bind IsArchived, Converter={StaticResource ArchivedForeground}}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <toolkit:GridSplitter Grid.Column="1"
                              Width="16"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" />

        <controls:EntityListView Grid.Column="2"
                                 Title="Материалы"
                                 Message="{x:Bind MaterialsViewModel.Message, Mode=OneWay}"
                                 CreateClicked="OnCreateMaterialClick">

            <controls:EntityListView.Table>
                <tv:TableView Style="{StaticResource EntityTableStyle}"
                              ItemsSource="{x:Bind MaterialsViewModel.Materials}"
                              ItemClick="OnMaterialClick">
                    <tv:TableView.ConditionalCellStyles>
                        <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsArchivedMaterial}">
                            <tv:TableViewConditionalCellStyle.Style>
                                <Style TargetType="tv:TableViewCell">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </Style>
                            </tv:TableViewConditionalCellStyle.Style>
                        </tv:TableViewConditionalCellStyle>
                    </tv:TableView.ConditionalCellStyles>
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" />
                        <tv:TableViewTextColumn Header="Наименование" Binding="{Binding Name}" Width="Auto" />
                        <tv:TableViewTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="Auto" />
                        <tv:TableViewTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </controls:EntityListView.Table>
        </controls:EntityListView>
    </Grid>
</Page>
