<Page x:Class="PNMaterialsClient.Views.MaterialsSplitPage"
      NavigationCacheMode="Enabled"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:tv="using:WinUI.TableView">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="200" MaxWidth="350" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0"
              RowSpacing="8"
              Background="{StaticResource PanelBrush}"
              CornerRadius="8"
              BorderThickness="1"
              BorderBrush="{StaticResource PanelBorderBrush}">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Группы"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Padding="12, 8, 12, 4" />

            <ListView Grid.Row="1"
                      x:Name="GroupsList"
                      ItemsSource="{x:Bind MaterialGroupsViewModel.Groups}"
                      ItemContainerStyle="{StaticResource RoundedListViewItemStyle}"
                      IsItemClickEnabled="True"
                      ItemClick="OnGroupClick">
                
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:MaterialGroupDto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Click="OnEditGroupClick"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="24" Height="24" Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent">
                                
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="Transparent" />
                                </Button.Resources>
                                
                                <FontIcon Glyph="&#xE70F;"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          FontWeight="Light"
                                          FontSize="10" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <toolkit:GridSplitter Grid.Column="1"
                              Width="16"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext" />

        <TextBlock Grid.Column="2"
           Text="Для просмотра материалов выберите группу."
           FontSize="24"
           FontWeight="SemiBold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Visibility="{x:Bind ShowWhenNoGroupSelected(MaterialsViewModel.IsGroupSelected), Mode=OneWay}" />

        <Grid Grid.Column="2" RowSpacing="8" Visibility="{x:Bind MaterialsViewModel.IsGroupSelected, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Материалы"
                           FontSize="24"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <ToggleButton Grid.Column="1"
                              Height="32"
                              Width="32"
                              Padding="0"
                              Click="OnIncludeArchivedClick"
                              ToolTipService.ToolTip="Показывать архивированные материалы">
                    <FontIcon x:Name="ArchiveToggleIcon"
                              Glyph="&#xE890;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" />
                </ToggleButton>
            </Grid>

            <tv:TableView Grid.Row="1"
                          Style="{StaticResource EntityTableStyle}"
                          ItemsSource="{x:Bind MaterialsViewModel.Materials}"
                          ItemClick="OnMaterialClick">
                <tv:TableView.ConditionalCellStyles>
                    <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsArchivedMaterial}">
                        <tv:TableViewConditionalCellStyle.Style>
                            <Style TargetType="tv:TableViewCell">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            </Style>
                        </tv:TableViewConditionalCellStyle.Style>
                    </tv:TableViewConditionalCellStyle>
                </tv:TableView.ConditionalCellStyles>
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Header="Код" Binding="{Binding Code}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Наименование" Binding="{Binding Name}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Ед. изм." Binding="{Binding UnitName}" Width="Auto" />
                    <tv:TableViewTextColumn Header="Описание" Binding="{Binding Description}" Width="*" />
                </tv:TableView.Columns>
            </tv:TableView>
        </Grid>
    </Grid>
</Page>
