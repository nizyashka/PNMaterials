<Page x:Class="PNMaterialsClient.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="using:PNMaterialsClient.ViewModels"
      xmlns:converters="using:PNMaterialsClient.Converters"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:tv="using:WinUI.TableView">

    <Page.Resources>
        <converters:DateFormatConverter x:Key="DateFormat" />
    </Page.Resources>

    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.ClearCommand}"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Очистить">
                    <FontIcon Glyph="&#xE75C;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" />
                </Button>

                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Width="Auto"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Искать">
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14" />
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{StaticResource PanelBorderBrush}">
                <Grid RowSpacing="8" Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             Header="Код заявки"
                             PlaceholderText="Несколько — через запятую"
                             Text="{x:Bind ViewModel.RequestNumbersText, Mode=TwoWay}" />

                    <TextBox Grid.Row="1"
                             Header="Код материала"
                             PlaceholderText="Несколько — через запятую"
                             Text="{x:Bind ViewModel.MaterialCodesText, Mode=TwoWay}" />

                    <TextBox Grid.Row="2"
                             Header="Наименование материала"
                             PlaceholderText="Неизвестная часть — звёздочка"
                             Text="{x:Bind ViewModel.MaterialName, Mode=TwoWay}" />

                    <CalendarDatePicker Grid.Row="3"
                                        Header="Дата поставки с"
                                        PlaceholderText="Любая"
                                        Date="{x:Bind ViewModel.DeliveryFrom, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />

                    <CalendarDatePicker Grid.Row="4"
                                        Header="по"
                                        PlaceholderText="Любая"
                                        Date="{x:Bind ViewModel.DeliveryTo, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />

                    <TextBlock Grid.Row="5"
                               Text="Статус заявки"
                               Foreground="{StaticResource TextPrimaryBrush}" />

                    <DropDownButton Grid.Row="6"
                                    Content="{x:Bind ViewModel.StatusesSummary, Mode=OneWay}"
                                    HorizontalAlignment="Stretch">
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom" Closed="OnStatusesFlyoutClosed">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Statuses}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusFilterViewModel">
                                            <CheckBox Content="{x:Bind Status.Code}"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <CheckBox Grid.Row="7" Content="Не равно выбранным"
                              IsChecked="{x:Bind ViewModel.StatusNotEqual, Mode=TwoWay}"
                              MinWidth="0" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0"
                       Text="Отчет по заявкам на закупку"
                       FontSize="24"
                       FontWeight="SemiBold"
                       VerticalAlignment="Top" />

            <controls:MessageBar Grid.Row="1"
                                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

            <tv:TableView Grid.Row="2"
                          Style="{StaticResource EntityTableStyle}"
                          ItemsSource="{x:Bind ViewModel.Rows}">
                <tv:TableView.Columns>
                    <tv:TableViewTextColumn Header="Номер" Binding="{Binding Number}" Width="*" />
                    <tv:TableViewTextColumn Header="Дата поставки" Binding="{Binding DeliveryDate, Converter={StaticResource DateFormat}}" Width="*" />
                    <tv:TableViewTextColumn Header="Статус" Binding="{Binding Status.Title}" Width="*" />
                </tv:TableView.Columns>
            </tv:TableView>
        </Grid>
    </Grid>
</Page>
