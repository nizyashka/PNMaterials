<Page x:Class="PNMaterialsClient.Views.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:contracts="using:PNMaterialsContracts"
      xmlns:vm="using:PNMaterialsClient.ViewModels"
      xmlns:converters="using:PNMaterialsClient.Converters">

    <Page.Resources>
        <converters:DateFormatConverter x:Key="DateFormat" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Отчет по заявкам на закупку" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Content="Найти" Command="{x:Bind ViewModel.SearchCommand}" />
            <Button Content="Очистить" Command="{x:Bind ViewModel.ClearCommand}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Header="Код заявки"
                         PlaceholderText="несколько — через запятую"
                         Text="{x:Bind ViewModel.RequestNumbersText, Mode=TwoWay}" />

                <TextBox Grid.Column="1" Header="Код материала"
                         PlaceholderText="несколько — через запятую"
                         Text="{x:Bind ViewModel.MaterialCodesText, Mode=TwoWay}" />

                <TextBox Grid.Column="2" Header="Наименование материала"
                         PlaceholderText="неизвестная часть — звёздочка"
                         Text="{x:Bind ViewModel.MaterialName, Mode=TwoWay}" />
            </Grid>

            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <CalendarDatePicker Header="Дата поставки с"
                                        Date="{x:Bind ViewModel.DeliveryFrom, Mode=TwoWay}"
                                        MinWidth="200" />
                    <CalendarDatePicker Header="по"
                                        Date="{x:Bind ViewModel.DeliveryTo, Mode=TwoWay}"
                                        MinWidth="200" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="Статус заявки" Opacity="0.7" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Statuses, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusFilterViewModel">
                                <CheckBox Content="{x:Bind Title}"
                                          IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                          MinWidth="0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox Content="не равно выбранным"
                              IsChecked="{x:Bind ViewModel.StatusNotEqual, Mode=TwoWay}"
                              MinWidth="0" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Opacity="0.7" />
            <TextBlock Text="Заявок по заданным критериям выборки не найдено"
                       FontWeight="SemiBold"
                       Visibility="{x:Bind ViewModel.IsEmptyResult, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="12" Padding="12,0,12,4" Opacity="0.6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Код заявки" />
                <TextBlock Grid.Column="1" Text="Требуемая дата поставки" />
                <TextBlock Grid.Column="2" Text="Статус заявки" />
            </Grid>

            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="contracts:PurchaseRequestReportRowDto">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{x:Bind Number}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind DeliveryDate, Converter={StaticResource DateFormat}}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Status.Name}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
