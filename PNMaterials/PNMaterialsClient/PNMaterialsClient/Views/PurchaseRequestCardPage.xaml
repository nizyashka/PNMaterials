<Page x:Class="PNMaterialsClient.Views.PurchaseRequestCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:PNMaterialsClient.Controls"
      xmlns:vm="using:PNMaterialsClient.ViewModels">

    <controls:EntityCard Header="{x:Bind ViewModel.Header, Mode=OneWay}"
                         IsEditMode="{x:Bind ViewModel.IsEditMode, Mode=TwoWay}"
                         SaveCommand="{x:Bind ViewModel.SaveCommand}"
                         RefreshCommand="{x:Bind ViewModel.RefreshCommand}"
                         ExitCommand="{x:Bind ExitCommand}">

        <controls:EntityCard.ExtraButtons>
            <ItemsControl ItemsSource="{x:Bind ViewModel.StatusActions, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatusActionViewModel">
                        <Button Content="{x:Bind Text}" Command="{x:Bind Command}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </controls:EntityCard.ExtraButtons>

        <ScrollViewer>
            <StackPanel Spacing="20">

                <StackPanel Spacing="12" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBox Header="Номер заявки"
                             Text="{x:Bind ViewModel.Number, Mode=OneWay}"
                             IsEnabled="False" />

                    <TextBox Header="Дата-время создания"
                             Text="{x:Bind ViewModel.CreatedAt, Mode=OneWay}"
                             IsEnabled="False" />

                    <TextBox Header="Статус заявки"
                             Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                             IsEnabled="False" />

                    <DatePicker Header="Дата поставки"
                                Date="{x:Bind ViewModel.DeliveryDate, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
                                HorizontalAlignment="Stretch" />
                </StackPanel>

                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Позиции заявки" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Button Content="Добавить позицию"
                                Command="{x:Bind ViewModel.AddItemCommand}"
                                IsEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}" />
                    </StackPanel>

                    <Grid ColumnSpacing="8" Padding="0,0,0,4" Opacity="0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="НН материала" />
                        <TextBlock Grid.Column="1" Text="Наименование" />
                        <TextBlock Grid.Column="2" Text="Ед. изм." />
                        <TextBlock Grid.Column="3" Text="Количество" />
                        <TextBlock Grid.Column="4" Text="Текст к позиции" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RequestItemViewModel">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
          ItemsSource="{x:Bind Materials}"
          SelectedItem="{x:Bind Material, Mode=TwoWay}"
          DisplayMemberPath="Code"
          IsEnabled="{x:Bind IsEditMode, Mode=OneWay}"
          HorizontalAlignment="Stretch" />

                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind MaterialName, Mode=OneWay}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind UnitName, Mode=OneWay}"
                                               VerticalAlignment="Center" />

                                    <NumberBox Grid.Column="3"
                                               Value="{x:Bind Quantity, Mode=TwoWay}"
                                               Minimum="0.01" Maximum="999999.99"
                                               SpinButtonPlacementMode="Compact"
                                               IsEnabled="{x:Bind IsEditMode, Mode=OneWay}" />

                                    <TextBox Grid.Column="4"
                                             Text="{x:Bind PositionText, Mode=TwoWay}"
                                             MaxLength="200"
                                             IsEnabled="{x:Bind IsEditMode, Mode=OneWay}" />

                                    <Button Grid.Column="5" Content="✕"
                                            Command="{x:Bind RemoveCommand}"
                                            IsEnabled="{x:Bind IsEditMode, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </controls:EntityCard>
</Page>
