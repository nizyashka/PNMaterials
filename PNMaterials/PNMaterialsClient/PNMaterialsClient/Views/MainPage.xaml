<Page x:Class="PNMaterialsClient.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="using:PNMaterialsClient.Services"
      xmlns:controls="using:PNMaterialsClient.Views.Controls"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid Background="{StaticResource AppBackgroundBrush}">
            <Grid Margin="8" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      ColumnSpacing="8"
                      Padding="6"
                      Background="{StaticResource TabBarBackgroundBrush}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource PanelBorderBrush}"
                      CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">

                        <Button x:Name="CreateRequestButton"
                            Content="Создать заявку"
                            Style="{StaticResource IconButtonStyle}"
                            Width="Auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Click="OnCreateRequestClick"
                            ToolTipService.ToolTip="Создать заявку"
                            Padding="8" />
                    </StackPanel>

                    <ItemsControl x:Name="MainMenu"
                                  Grid.Column="1"
                                  VerticalAlignment="Center">
                        <ItemsControl.Resources>
                            <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource TextPrimaryColor}" />
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource TextPrimaryColor}" />
                        </ItemsControl.Resources>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <Frame x:Name="ContentFrame" Grid.Row="1" />
            </Grid>
        </Grid>

        <Popup x:Name="InfoPopup">
            <Grid x:Name="PopupGrid">
                <ItemsControl x:Name="PopupItemsControl"
                              ItemsSource="{x:Bind MessagesService.Messages, Mode=OneWay}"
                              Width="300"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Padding="16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:UiMessage">
                            <controls:MessageBar Message="{x:Bind}" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Popup>
    </Grid>
</Page>
