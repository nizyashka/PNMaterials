<Page x:Class="PNMaterialsClient.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:nav="using:PNMaterialsClient.Navigation"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="FolderTemplate" x:DataType="nav:NavFolder">
            <TreeViewItem ItemsSource="{x:Bind Children}"
                      IsExpanded="{x:Bind IsExpanded}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8B7;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>

        <DataTemplate x:Key="PageTemplate" x:DataType="nav:NavPage">
            <TreeViewItem>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE8A5;"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}"
                              FontSize="14"
                              Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </TreeViewItem>
        </DataTemplate>

        <nav:NavItemTemplateSelector x:Key="NavItemTemplateSelector"
                                     FolderTemplate="{StaticResource FolderTemplate}"
                                     PageTemplate="{StaticResource PageTemplate}" />
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid Margin="8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{StaticResource PanelBorderBrush}">
                <TreeView x:Name="NavTree"
                          ItemsSource="{x:Bind NavItems}"
                          ItemTemplateSelector="{StaticResource NavItemTemplateSelector}"
                          SelectionMode="Single"
                          ItemInvoked="OnNavItemInvoked"
                          Margin="-8, 0, 8, 0">
                    <TreeView.Resources>
                        <SolidColorBrush x:Key="TreeViewItemForeground" Color="{StaticResource TextSecondaryBrush}" />
                        <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="{StaticResource SelectedColor}" />
                        <SolidColorBrush x:Key="TreeViewItemBackgroundPointerOver" Color="{StaticResource HoverColor}" />
                        <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="{StaticResource TextPrimaryBrush}" />
                    </TreeView.Resources>
                </TreeView>
            </Border>
            
            <Frame x:Name="ContentFrame" Grid.Column="1"/>
        </Grid>
    </Grid>
</Page>
