<Page x:Class="PNMaterialsClient.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Справочники">
                <MenuFlyoutItem Text="Материалы" Click="OnMaterialsClick" />
                <MenuFlyoutItem Text="Группы материалов" Click="OnMaterialGroupsClick" />
            </MenuBarItem>

            <MenuBarItem Title="Заявки">
                <MenuFlyoutItem Text="Список заявок" Click="OnPurchaseRequestsClick" />
            </MenuBarItem>

            <MenuBarItem Title="Отчеты">
                <MenuFlyoutItem Text="Отчет по заявкам на закупку" Click="OnReportClick" />
            </MenuBarItem>
        </MenuBar>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Page>
